{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rampart.aspm.dev/schemas/message.v1.json",
  "title": "Message",
  "description": "Canonical notification message document for Notifier integrations in Rampart ASPM (docs/19 §3, §6)",
  "type": "object",
  "required": [
    "title"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Message title or subject line"
    },
    "summary": {
      "type": "string",
      "description": "Short plain-text summary for push notifications or channel previews"
    },
    "body": {
      "type": "string",
      "description": "Detailed markdown or rich text body"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "In-app link to act on or view the notification"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "description": "Severity level of the alert"
    },
    "type": {
      "type": "string",
      "description": "Notification category (e.g. sla_breached, sla_due_soon, gate_failed, new_critical)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string" },
          "band": { "type": "string" },
          "app": { "type": "string" },
          "link": { "type": "string", "format": "uri" }
        },
        "required": ["title"]
      },
      "description": "List of affected items or findings included in this notification digest"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context key-values"
    }
  },
  "additionalProperties": false
}

