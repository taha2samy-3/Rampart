# The parser repositories whose modules the Go tests run (.github/actions/parser-modules builds them). Rampart holds no parser.
# REF is a branch, tag or commit SHA. Pin each to the commit the tests were last run against, so a change in a parser repository
# reaches Rampart's CI only when this file changes.
PARSERS_REPO=Rampart-Aspm/parsers
PARSERS_REF=main
SBOM_PARSERS_REPO=Rampart-Aspm/sbom-parsers
SBOM_PARSERS_REF=main
