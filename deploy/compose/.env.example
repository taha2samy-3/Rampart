# Copy to .env and change every value. docker compose refuses to start without them.
RAMPART_OWNER_PASSWORD=change-me-owner
RAMPART_APP_PASSWORD=change-me-app
RAMPART_SYSTEM_PASSWORD=change-me-system
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key-min-20-chars
RAMPART_OIDC_CLIENT_SECRET=change-me-oidc-client-secret
# Exactly 32 characters. Generate: openssl rand -hex 16
RAMPART_SESSION_KEY=change-me-change-me-change-me-12
