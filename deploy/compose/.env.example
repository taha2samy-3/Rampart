# Do not copy this file by hand: run ./init.sh, which writes .env with random values for all of these
# and renders dex/config.yaml. This file only documents the names.
RAMPART_OWNER_PASSWORD=
RAMPART_APP_PASSWORD=
RAMPART_SYSTEM_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
RAMPART_OIDC_CLIENT_SECRET=
# Exactly 32 characters.
RAMPART_SESSION_KEY=
# The first administrator created inside Rampart (username: admin).
RAMPART_ADMIN_PASSWORD=
# Demo users in Dex.
DEMO_ADMIN_PASSWORD=
DEMO_VIEWER_PASSWORD=
