# Binaries
bin/
# a binary built at the root with `go build ./cmd/rampart` (anchored: cmd/rampart/ is source)
/rampart
# the subcharts `helm dependency update` pulls into the chart
deploy/helm/rampart/charts/*.tgz
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts
*.out
*.test
coverage.txt

# OS / Editor artifacts
node_modules/
.DS_Store
.idea/
.vscode/
*.swp

.env
.env.*
*.key
secrets/

# Generated by deploy/compose/init.sh (contain secrets or password hashes)
deploy/compose/.env
.env.*
*.key
secrets/
deploy/compose/dex/config.yaml

# Working review/planning notes, not part of the project docs
NOTES_*.md
# WASM modules built for the tests (hack/test-modules.sh) and the parser repositories CI checks out
/.cache/
# The default parsers the Compose quick start reads (deploy/compose/fetch-parsers.sh fills them)
/deploy/compose/parsers/*
/deploy/compose/wasm/*
!/deploy/compose/parsers/.gitkeep
!/deploy/compose/wasm/.gitkeep
